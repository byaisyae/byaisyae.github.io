# Salin menjadi .env (lokal) bila perlu. Semua opsional.
# Domain tempat undangan di-host (tanpa garis miring di akhir). Default: https://saevitation.com
# VITE_SITE_URL=https://saevitation.com

# URL Web App Google Apps Script (berakhiran /exec) — dipakai form testimoni DAN dashboard admin
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXX/exec
